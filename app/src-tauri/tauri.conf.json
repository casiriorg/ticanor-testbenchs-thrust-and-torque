{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ticanor Testbench",
  "version": "0.1.0",
  "identifier": "org.ticanor.testbench",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "Ticanor Testbench", "width": 1360, "height": 860, "minWidth": 1000, "minHeight": 640 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
